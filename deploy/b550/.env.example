# MinIO credentials for the Milvus stack in deploy/b550/docker-compose.yml.
# Copy this file to deploy/b550/.env, set real values, and keep the file
# mode 0600. deploy/b550/.env is git-ignored; compose reads it from the
# directory that holds the compose file (the deployed milvus/ copy on B550).

# Root user and password MinIO starts with; Milvus uses the same pair to
# authenticate against MinIO over the compose network.
MINIO_ROOT_USER=change-me-user
MINIO_ROOT_PASSWORD=change-me-long-random-password
